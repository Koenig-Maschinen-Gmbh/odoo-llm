<?xml version="1.0" encoding="utf-8" ?>
<templates>
    <!--
    Extend Chatter to add AI Chat button and inline AI chat mode.

    IMPORTANT: This extension is intentionally NON-DESTRUCTIVE. It must not
    replace the whole `o-mail-Chatter-content` subtree, because other addons
    inject siblings into it (e.g. cloud_base injects the SharePoint folder
    tree `.cb-attachment-box` into the AttachmentBox). A `position="replace"`
    with a hardcoded copy of the content silently drops every such injection
    (it dropped cloud_base's folder tree once llm_thread was installed).

    Instead we: (1) flag the content container while AI chat is active and
    (2) append the AI chat host. CSS (`chatter_ai.scss`) hides the normal
    content while chatting, so only the AI chat is visible — without touching
    or recopying any sibling content.
    -->
    <t
    t-name="llm_thread.ChatterAIExtension"
    t-inherit="mail.Chatter"
    t-inherit-mode="extension"
  >
        <!-- Add AI button before the spacer in the left buttons section -->
        <xpath
      expr="//span[hasclass('o-mail-Chatter-topbarGrow')]"
      position="before"
    >
            <!-- Toggle AI Chat button. While chatting the button carries
                 ``o-open`` — a pushed-down (pressed) style instead of a
                 primary fill (2026-07-30 UX round 2). -->
            <button
        t-if="shouldShowAIButton"
        class="o-mail-Chatter-aiChat btn text-nowrap ms-1 me-1"
        t-att-class="{
            'o-open': state.isChattingWithLLM,
            'my-2': !props.compactHeight
        }"
        type="button"
        t-on-click="onAIChatClick"
        t-att-title="state.isChattingWithLLM ? 'Exit AI Chat' : 'Start AI Chat'"
      >
                <i class="fa fa-robot me-1" role="img" aria-label="AI Chat" />
                <span
          class="d-none d-sm-inline"
          t-esc="state.isChattingWithLLM ? 'Exit AI' : 'AI'"
        />
                <!-- Thread-count badge (same shape as the Wiki notebook
                     badge): how many AI chats exist on this record. Hidden
                     at 0. Decorative — failures never break the chatter. -->
                <sup
          t-if="state.llmThreadCount"
          class="o-llm-ThreadCount ms-1"
          title="AI chats on this record"
          t-esc="state.llmThreadCount"
        />
            </button>
        </xpath>

        <!--
        Flag the content container while AI chat is active (CSS hides the
        normal content). This MERGES with the existing static class; it does
        not replace the subtree, so sibling injections survive.
        -->
        <xpath
      expr="//div[hasclass('o-mail-Chatter-content')]"
      position="attributes"
    >
            <attribute name="t-att-class">{ 'o-llm-chatting': state.isChattingWithLLM }</attribute>
        </xpath>

        <!-- Append the AI chat host; only rendered while chatting. -->
        <xpath
      expr="//div[hasclass('o-mail-Chatter-content')]"
      position="inside"
    >
            <div
        class="o-llm-ChatHost d-flex flex-column flex-grow-1"
        t-if="state.isChattingWithLLM"
      >
                <LLMChatContainer
          recordModel="props.threadModel"
          recordId="props.threadId"
        />
            </div>
        </xpath>
    </t>
</templates>
