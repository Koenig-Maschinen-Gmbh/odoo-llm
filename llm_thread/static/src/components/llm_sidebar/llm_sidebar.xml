<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="llm_thread.LLMSidebar">
        <!-- Collapsed (desktop only): a centered expand button. -->
        <div
            t-if="props.isCollapsed"
            class="o-llm-sidebar-header d-flex align-items-center justify-content-center px-2 py-3 border-bottom"
        >
            <button
                type="button"
                class="btn btn-secondary btn-sm px-2 py-1"
                t-on-click="toggleSidebar"
                title="Expand sidebar"
            >
                <i class="oi oi-panel-right" style="transform: rotate(180deg);" />
            </button>
        </div>

        <!-- Expanded: full sidebar (mobile slide-in + desktop expanded share
             this markup; the container's wrapper handles the layout). -->
        <div t-else="" class="d-flex flex-column flex-grow-1 min-vh-0">
            <!-- Header -->
            <div
                class="o-llm-sidebar-header border-bottom p-3"
            >
                <!-- Brand row: full-width logo (SVG viewBox is cropped to the
                     glyph bounds, ~9.3:1, so the rendered wordmark fills the
                     row instead of sitting in a sea of canvas padding). -->
                <div class="o-llm-sidebar-brand mb-2">
                    <img
                        src="/llm_thread/static/src/img/koenig_intelligence_brand.svg"
                        alt="König Intelligence"
                        class="o-llm-sidebar-logo"
                    />
                </div>
                <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <button
                        type="button"
                        class="btn btn-sm btn-primary"
                        t-on-click="createNewThread"
                        title="New Thread"
                    >
                        <i class="fa fa-plus" />
                    </button>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <button
                        type="button"
                        class="btn btn-sm btn-link px-1 py-0"
                        t-att-class="{ 'active fw-bold': state.selectMode }"
                        t-on-click="toggleSelectMode"
                        title="Select threads"
                    >
                        <i class="fa fa-check-square-o" />
                    </button>
                    <button
                        type="button"
                        class="btn btn-sm btn-link px-1 py-0"
                        t-att-class="{ 'active fw-bold': state.showArchived }"
                        t-on-click="() => this.state.showArchived = !this.state.showArchived"
                        title="Show archived"
                    >
                        <i class="fa fa-archive" />
                    </button>
                    <!-- UI-11: reveal expert sub-threads for debugging. -->
                    <button
                        type="button"
                        class="btn btn-sm btn-link px-1 py-0"
                        t-att-class="{ 'active fw-bold': state.showExpertThreads }"
                        t-on-click="() => this.state.showExpertThreads = !this.state.showExpertThreads"
                        title="Show expert threads"
                    >
                        <i class="fa fa-user-secret" />
                    </button>
                    <button
                        t-if="!props.isMobile"
                        type="button"
                        class="btn btn-secondary btn-sm px-2 py-1"
                        t-on-click="toggleSidebar"
                        title="Collapse sidebar"
                    >
                        <i class="oi oi-panel-right" />
                    </button>
                </div>
                </div>
            </div>

            <!-- Search -->
            <div class="o-llm-sidebar-search p-2 border-bottom">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="fa fa-search text-muted" />
                    </span>
                    <input
                        type="text"
                        class="form-control border-start-0"
                        placeholder="Search conversations…"
                        t-model="state.searchVal"
                        t-on-input="onSearchInput"
                    />
                    <button
                        t-if="state.searchVal"
                        type="button"
                        class="btn btn-sm btn-link px-1"
                        t-on-click="clearSearch"
                        title="Clear search"
                    >
                        <i class="fa fa-times text-muted" />
                    </button>
                </div>
            </div>

            <!-- Bulk-action toolbar (select mode) -->
            <div
                t-if="state.selectMode"
                class="o-llm-sidebar-toolbar d-flex align-items-center gap-1 border-bottom p-2 flex-shrink-0"
            >
                <small class="text-muted me-1">
                    <t t-out="selectedCount" /> selected
                </small>
                <button
                    type="button"
                    class="btn btn-sm btn-link px-1"
                    t-on-click="selectAllVisible"
                    title="Select all visible"
                >
                    <i class="fa fa-list" />
                </button>
                <button
                    type="button"
                    class="btn btn-sm btn-link px-1"
                    t-att-disabled="!selectedCount"
                    t-on-click="bulkTag"
                    title="Tag selected"
                >
                    <i class="fa fa-tag" />
                </button>
                <button
                    type="button"
                    class="btn btn-sm btn-link px-1"
                    t-att-disabled="!selectedCount"
                    t-on-click="bulkArchive"
                    title="Archive selected"
                >
                    <i class="fa fa-archive" />
                </button>
                <button
                    type="button"
                    class="btn btn-sm btn-link px-1 text-danger"
                    t-att-disabled="!selectedCount"
                    t-on-click="bulkDelete"
                    title="Delete selected"
                >
                    <i class="fa fa-trash-o" />
                </button>
            </div>

            <!-- Thread list -->
            <div class="o-llm-sidebar-list flex-grow-1 overflow-auto">
                <!-- Empty state -->
                <div
                    t-if="filteredThreadList.length === 0"
                    class="p-3 text-center text-muted"
                >
                    <i class="fa fa-comments-o fa-2x mb-2" />
                    <div>No conversations found</div>
                    <small t-if="state.searchVal">Try a different search</small>
                    <small t-else="">Start your first AI chat</small>
                </div>

                <!-- Grouped by date bucket -->
                <t
                    t-foreach="groupedThreadList"
                    t-as="bucket"
                    t-key="bucket.key"
                >
                    <div class="o-llm-bucket">
                        <div
                            class="o-llm-bucket-header d-flex align-items-center justify-content-between cursor-pointer"
                            t-on-click="() => this.toggleBucket(bucket.key)"
                        >
                            <span class="text-truncate">
                                <i
                                    t-att-class="isBucketCollapsed(bucket.key) ? 'fa fa-caret-right me-1' : 'fa fa-caret-down me-1'"
                                />
                                <t t-out="bucket.label" />
                            </span>
                            <span class="badge rounded-pill bg-light text-muted">
                                <t t-out="bucket.threads.length" />
                            </span>
                        </div>
                        <t t-if="!isBucketCollapsed(bucket.key)">
                            <t
                                t-foreach="bucket.threads"
                                t-as="thread"
                                t-key="thread.id"
                            >
                                <div
                                    class="o-llm-thread-item cursor-pointer"
                                    t-att-class="{
                                        'o-llm-thread-active': thread.id === activeThread?.id,
                                        'o-llm-thread-archived': thread.active === false,
                                        'o-llm-thread-selected': state.selectedThreadIds[thread.id],
                                    }"
                                    t-on-click="() => this.selectThread(thread.id)"
                                    t-att-title="threadTooltip(thread)"
                                >
                                    <div class="d-flex align-items-center gap-1">
                                        <input
                                            t-if="state.selectMode"
                                            type="checkbox"
                                            class="form-check-input flex-shrink-0"
                                            t-att-checked="!!state.selectedThreadIds[thread.id]"
                                            t-on-click.stop="() => this.toggleSelectThread(thread.id)"
                                        />
                                        <span class="text-truncate flex-grow-1" t-out="thread.name" />
                                        <span class="o-llm-thread-status flex-shrink-0 d-flex align-items-center gap-1">
                                            <!-- UI-08 B2 + P-CHAT M3: persistent status icon per thread.
                                                 idle = no icon, running = spinner, error = red dot,
                                                 done = green check (fades after 10s via CSS). -->
                                            <t t-if="threadElapsedLabel(thread.id)">
                                                <i class="fa fa-circle-o-notch fa-spin text-primary" />
                                                <t t-out="threadElapsedLabel(thread.id)" />
                                            </t>
                                            <i
                                                t-elif="threadFinishedFlash(thread.id) === 'done'"
                                                class="fa fa-check-circle text-success o-llm-status-done"
                                                title="Done"
                                            />
                                            <i
                                                t-elif="threadFinishedFlash(thread.id) === 'failed'"
                                                class="fa fa-exclamation-circle text-danger"
                                                title="Failed"
                                            />
                                            <i
                                                t-elif="threadFinishedFlash(thread.id) === 'cancelled'"
                                                class="fa fa-ban text-muted"
                                                title="Cancelled"
                                            />
                                            <i
                                                t-elif="isStreamingThread(thread.id)"
                                                class="fa fa-circle-o-notch fa-spin text-primary"
                                            />
                                        </span>
                                    </div>
                                </div>
                            </t>
                        </t>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>