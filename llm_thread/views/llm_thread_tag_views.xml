<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- P-UX: LLM Thread Tag management (user-manageable colored tags). -->
    <record id="llm_thread_tag_view_form" model="ir.ui.view">
        <field name="name">llm.thread.tag.form</field>
        <field name="model">llm.thread.tag</field>
        <field name="arch" type="xml">
            <form string="Tag">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="color" widget="color_picker" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="llm_thread_tag_view_list" model="ir.ui.view">
        <field name="name">llm.thread.tag.list</field>
        <field name="model">llm.thread.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom" multi_edit="1" default_order="name">
                <field name="name" />
                <field name="color" widget="color_picker" optional="show" />
            </list>
        </field>
    </record>

    <record id="llm_thread_tag_view_search" model="ir.ui.view">
        <field name="name">llm.thread.tag.search</field>
        <field name="model">llm.thread.tag</field>
        <field name="arch" type="xml">
            <search string="Tags">
                <field name="name" />
            </search>
        </field>
    </record>

    <record id="llm_thread_tag_action" model="ir.actions.act_window">
        <field name="name">Chat Tags</field>
        <field name="res_model">llm.thread.tag</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tags found. Let's create one!
            </p>
            <p>
                Use tags to categorize your AI chat threads.
            </p>
        </field>
    </record>
</odoo>
