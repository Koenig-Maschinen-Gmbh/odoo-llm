<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_llm_tool_bundle_tree" model="ir.ui.view">
        <field name="name">llm.tool.bundle.tree</field>
        <field name="model">llm.tool.bundle</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="tool_count" />
                <field name="active" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_llm_tool_bundle_form" model="ir.ui.view">
        <field name="name">llm.tool.bundle.form</field>
        <field name="model">llm.tool.bundle</field>
        <field name="arch" type="xml">
            <form string="LLM Tool Bundle">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1><field name="name" placeholder="e.g. Web Research" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. web_research" />
                            <field name="sequence" />
                            <field name="active" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Tools">
                            <field name="tool_ids">
                                <list>
                                    <field name="name" />
                                    <field name="implementation" />
                                    <field name="active" />
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field
                name="description"
                placeholder="What capability this bundle provides"
              />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_llm_tool_bundle_search" model="ir.ui.view">
        <field name="name">llm.tool.bundle.search</field>
        <field name="model">llm.tool.bundle</field>
        <field name="arch" type="xml">
            <search string="Search Tool Bundles">
                <field name="name" />
                <field name="code" />
                <field name="tool_ids" />
                <filter
          string="Active"
          name="active"
          domain="[('active', '=', True)]"
        />
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_llm_tool_bundle" model="ir.actions.act_window">
        <field name="name">Tool Bundles</field>
        <field name="res_model">llm.tool.bundle</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new tool bundle
            </p>
            <p>
                A bundle is a named capability pack of tools. Assistants
                subscribe to bundles instead of linking each tool individually.
            </p>
        </field>
    </record>
</odoo>
